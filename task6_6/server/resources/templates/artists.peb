{% extends "base.peb" %}
{% block title %}Artists | Music Database{% endblock %}
{% block main %}
<h1>Artists</h1>
{% if artists is not empty %}
<ul>
  {% for artist in artists %}
  <li>{{ artist.name }}</li>
  {% endfor %}
</ul>
{% else %}
<p>No artists in the database.</p>
{% endif %}
<p><a href="/">Back to the music database</a></p>
{% endblock %}
