<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <title>Dice Roll Result</title>
</head>
<body>
<main class="container">
<h1>Result of Roll</h1>

<section>
  <p>You rolled <strong>{{ roll.name }}</strong></p>
  {% if roll.numDice > 1 %}
    <p>The die values are <strong>{{ roll.dieValues }}</strong></p>
    <p>The total is <strong>{{ roll.total }}</strong></p>
  {% else %}
     <p>The result is <strong>{{ roll.total }}</strong></p>
  {% endif %}
</section>

<section>
  <a role="button" href="{{ reroll_uri }}">Repeat</a>
  <a role="button" href="/">New Roll</a>
</section>
</main>

<footer class="container">
  <small><i>Task 4.6.2, Ktor Web Development Guide</i></small>
</footer>
</body>
</html>
