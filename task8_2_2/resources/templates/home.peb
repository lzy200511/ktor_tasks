{# Task 8.2.2: single-page applications #}
{% extends "base.peb" %}
{% block content %}
<div class="grid">
  <div>
    <article id="form">
      {% include "form.peb" %}
    </article>
  </div>
  <div>
    <article id="results">
      {# Results of dice roll will be swapped in here by htmx #}
      <header><strong>Last Roll</strong></header>
      <p><em>None</em></p>
    </article>
  </div>
</div>
{% endblock %}
